# --- Relay configuration ---
PORT=3001

# Production database. Unset → embedded SQLite at ./data/relay.db (zero-config local demo).
# Set → PostgreSQL (a Supabase pooler URL works). pglite://memory is supported for
# in-process dev E2E (requires `npm i --no-save @electric-sql/pglite`).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: enables the real LLM path (OpenAI-compatible).
# Without a key the app uses its transparent rule-based fallback engine instead.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: real Google/Microsoft OAuth for production use.
# Without these, connecting Gmail/Outlook runs in clearly-labelled demo mode.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...

# Gmail OAuth (optional) — real mailbox access. Without these, Gmail connects
# in clearly-labelled demo mode and no real mail is touched.
# Create an OAuth *Web application* client in Google Cloud Console with redirect:
#   http://localhost:3001/api/gmail/callback           (local dev)
#   https://<your-domain>/api/gmail/callback           (production)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# Required in production when Gmail is enabled — encrypts stored OAuth tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
# GMAIL_TOKEN_SECRET=
# Optional: explicit redirect URI (defaults to <request origin>/api/gmail/callback)
# GMAIL_REDIRECT_URI=https://your-domain.vercel.app/api/gmail/callback
